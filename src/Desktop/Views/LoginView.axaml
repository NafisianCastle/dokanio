<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.ViewModels"
             x:Class="Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

  <Design.DataContext>
    <vm:LoginViewModel />
  </Design.DataContext>

  <!-- Explicit light-mode colors — never inherits OS dark theme -->
  <Border Background="White"
          CornerRadius="8"
          Padding="40"
          MaxWidth="400"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          BoxShadow="0 4 16 0 #1A000000">

    <StackPanel Spacing="20">

      <!-- Header -->
      <StackPanel Spacing="8" HorizontalAlignment="Center">
        <TextBlock Text="POS System Login"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#111827"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Please sign in to continue"
                   FontSize="14"
                   Foreground="#6B7280"
                   HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- Login Form -->
      <StackPanel Spacing="16">

        <!-- Username -->
        <StackPanel Spacing="4">
          <TextBlock Text="Username"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Foreground="#374151"/>
          <TextBox Text="{Binding Username}"
                   Watermark="Enter your username"
                   Classes="input-primary"
                   Background="White"
                   Foreground="#111827"
                   Height="44"
                   IsEnabled="{Binding !IsLoading}"/>
        </StackPanel>

        <!-- Password -->
        <StackPanel Spacing="4">
          <TextBlock Text="Password"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Foreground="#374151"/>
          <TextBox Text="{Binding Password}"
                   Watermark="Enter your password"
                   PasswordChar="•"
                   Classes="input-primary"
                   Background="White"
                   Foreground="#111827"
                   Height="44"
                   IsEnabled="{Binding !IsLoading}"
                   Name="PasswordBox"/>
        </StackPanel>

        <!-- Remember Me -->
        <CheckBox Content="Remember me"
                  IsChecked="{Binding RememberMe}"
                  FontSize="13"
                  Foreground="#374151"
                  IsEnabled="{Binding !IsLoading}"/>

        <!-- Error Message -->
        <Border Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚠️"
                       FontSize="15"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#DC2626"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Login Button -->
        <Button Content="Sign In"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding !IsLoading}"
                Classes="btn-primary btn-large"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                FontWeight="SemiBold"/>

        <!-- Loading Indicator -->
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsLoading}">
          <ProgressBar IsIndeterminate="True"
                       Width="20"
                       Height="20"
                       Classes="loading-circular"/>
          <TextBlock Text="Signing in…"
                     FontSize="13"
                     Foreground="#6B7280"
                     VerticalAlignment="Center"/>
        </StackPanel>

      </StackPanel>

      <!-- Footer -->
      <TextBlock Text="Offline-First POS System"
                 FontSize="12"
                 Foreground="#9CA3AF"
                 HorizontalAlignment="Center"/>

    </StackPanel>
  </Border>

</UserControl>