<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Desktop.ViewModels"
        x:Class="Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Dokanio POS — Sign In"
        Width="520"
        Height="620"
        MinWidth="420"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        RequestedThemeVariant="Light">

  <Design.DataContext>
    <vm:LoginViewModel />
  </Design.DataContext>

  <!-- Full-window split: left accent strip + right form area -->
  <Grid Background="#F0F4F8">

    <!-- Centered card that grows with the window -->
    <Border Background="White"
            CornerRadius="16"
            BoxShadow="0 8 40 0 #22000000"
            Margin="32"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

      <Grid>
        <Grid.RowDefinitions>
          <!-- Header: shrinks to content, never clips -->
          <RowDefinition Height="Auto"/>
          <!-- Form: takes all remaining space -->
          <RowDefinition Height="*"/>
          <!-- Footer button row: fixed -->
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#2196F3"
                CornerRadius="16,16,0,0"
                Padding="32,28">
          <StackPanel HorizontalAlignment="Center" Spacing="6">
            <TextBlock Text="🏪"
                       FontSize="44"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Dokanio POS"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Sign in to your account"
                       FontSize="14"
                       Foreground="White"
                       Opacity="0.85"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- ── Form (scrollable so it survives very small windows) ──── -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,28,32,16"
                      Spacing="20"
                      MaxWidth="380"
                      HorizontalAlignment="Center"
                      Width="{Binding $parent[ScrollViewer].Bounds.Width}"
                      MinWidth="0">

            <!-- Username -->
            <StackPanel Spacing="6">
              <TextBlock Text="Username"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="#374151"/>
              <TextBox Text="{Binding Username}"
                       Watermark="Enter your username"
                       Classes="input-primary"
                       FontSize="15"
                       Height="46"
                       Background="White"
                       Foreground="#111827"
                       IsEnabled="{Binding !IsLoading}"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Spacing="6">
              <TextBlock Text="Password"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="#374151"/>
              <TextBox Name="PasswordBox"
                       PasswordChar="•"
                       Watermark="Enter your password"
                       Classes="input-primary"
                       FontSize="15"
                       Height="46"
                       Background="White"
                       Foreground="#111827"
                       Text="{Binding Password}"
                       IsEnabled="{Binding !IsLoading}"/>
            </StackPanel>

            <!-- Remember me -->
            <CheckBox Content="Remember me"
                      IsChecked="{Binding RememberMe}"
                      FontSize="13"
                      Foreground="#374151"
                      IsEnabled="{Binding !IsLoading}"/>

            <!-- Error message -->
            <Border Background="#FEF2F2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#DC2626"
                           FontSize="13"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

            <!-- Authenticating indicator -->
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsLoading}">
              <ProgressBar IsIndeterminate="True"
                           Width="20"
                           Height="20"
                           Classes="loading-circular"/>
              <TextBlock Text="Authenticating…"
                         FontSize="13"
                         Foreground="#6B7280"
                         VerticalAlignment="Center"/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- ── Footer / Sign-in button ────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#F9FAFB"
                CornerRadius="0,0,16,16"
                Padding="32,20">
          <Button Command="{Binding LoginCommand}"
                  IsEnabled="{Binding !IsLoading}"
                  Classes="btn-primary btn-large"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  MaxWidth="380"
                  FontSize="15"
                  FontWeight="SemiBold">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ProgressBar IsVisible="{Binding IsLoading}"
                           IsIndeterminate="True"
                           Width="16"
                           Height="16"
                           VerticalAlignment="Center"/>
              <TextBlock Text="Sign In"
                         IsVisible="{Binding !IsLoading}"
                         VerticalAlignment="Center"/>
              <TextBlock Text="Signing in…"
                         IsVisible="{Binding IsLoading}"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <Button.Styles>
              <Style Selector="Button:disabled /template/ ContentPresenter">
                <Setter Property="Opacity" Value="0.6"/>
              </Style>
            </Button.Styles>
          </Button>
        </Border>

      </Grid>
    </Border>
  </Grid>
</Window>